pipeline{
    agent any
    tools {
    maven 'Maven'
    }
    stages{
        stage("Test"){
            
            steps{
                echo "========Check mvn version and run test cases========"                
                sh "mvn --version"
                sh "mvn test"
            }

        }

                stage("Build"){
      
            steps{
                echo "========Build a test cases========"
                sh "mvn package"
                archiveArtifacts artifacts: '**/target/*.war', allowEmptyArchive: true
            
            }

        }

                stage("Deploy on Test"){
                             agent {
                label 'test'  // Specify the label of the slave node for deployment
            }
                 
            steps{
sh 'sudo bash /home/ec2-user/tomcatsetup.sh'
echo "Tomcat has been configured successfully, now deploying a war file on the test servers"
copyArtifacts projectName: 'War-deploy-using-PP', filter: '**/*.war', target: '/tmp/'
 sh 'sudo cp /tmp/*.war /opt/tomcat/webapps/'
deploy adapters: [tomcat9(credentialsId: 'tccreds', path: '', url: 'http://13.235.71.248:8080/')], contextPath: '/app', war: '**/*.war'

}

        }

                stage("Deploy on Prod"){
            steps{
                echo "========executing A========"
            }

        }
    }
    post{
        always{
            echo "========always========"
        }
        success{
            echo "========pipeline executed successfully ========"
        }
        failure{
            echo "========pipeline execution failed========"
        }
    }
}
