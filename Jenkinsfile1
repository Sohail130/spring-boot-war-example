pipeline{
    agent none
    tools {
    maven 'Maven'
    }
    stages{
        stage("Test"){
            agent {
       label 'main'
     }
            steps{
                echo "========Check mvn version and run test cases========"                
                sh "mvn --version"
                sh "mvn test"
            }

        }

                stage("Build"){
        agent {
       label 'main'
     }
            steps{
                echo "========Build a test cases========"
                sh "mvn package"
               archiveArtifacts artifacts: 'target/*.war', allowEmptyArchive: true 

            }

        }

                stage("Deploy on Test"){
  agent {
       label 'test'
     }

            steps{
sh 'sudo bash /home/ec2-user/tomcatsetup.sh'
echo "Tomcat has been configured successfully, now deploying a war file on the test server"
 copyArtifacts(projectName: 'Your_Project_Name', filter: 'target/*.war', target: 'target/')
 deploy adapters: [tomcat9(credentialsId: 'tccreds', path: '', url: 'http://65.x.x.x:8080/')], contextPath: '/app', war: 'target/*.war'  
}

        }

                stage("Deploy on Prod"){
            steps{
                echo "========executing A========"
            }

        }
    }
    post{
        always{
            echo "========always========"
        }
        success{
            echo "========pipeline executed successfully ========"
        }
        failure{
            echo "========pipeline execution failed========"
        }
    }
}
